# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.
#
# RevenueCat public SDK keys (Project settings > API keys in the RevenueCat dashboard).
# Android keys start with goog_  (e.g. goog_xxxxxxxxxxxxxxxxxxxx)
# iOS keys start with    appl_  (e.g. appl_xxxxxxxxxxxxxxxxxxxx)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
